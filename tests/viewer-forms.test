# viewer-forms.test -- app/viewer4.tcl so bedienen, wie ein Mensch es tut
#
# WARUM ES DIESE DATEI GIBT:
#
# Am 06.09.2026 meldete ein Benutzer: "Schreibmarke gesetzt" stand da,
# und es liess sich nichts eingeben. Die Suite war gruen -- 84 Tests,
# kein Fehler. Sie mass die Teile einzeln: editclick trifft, editchar
# tippt, formfields liest. Jedes Stueck stimmte.
#
# Was fehlte, war die REIHENFOLGE. Der Benutzer klickt erst in die
# Feldliste, dann auf die Seite. Damit ist der Tastaturfokus weg, und
# der Klick auf den Canvas holte ihn nicht zurueck.
#
# Diese Datei spielt solche Folgen nach. Sie prueft nicht, ob ein Befehl
# tut, was er soll -- das tut basic.test --, sondern ob die Bedienung
# aufgeht.
#
# WICHTIG fuer die Nachbildung: "event generate" mit einem
# Tastenereignis geht an das FOKUSFENSTER, nicht an das Widget, das man
# angibt. Gemessen:
#
#     focus -force .e
#     event generate .c <Key-X>   ->  kam bei .e an
#
# Genau deshalb kann ein Tk-Test einen fehlenden Fokus ueberhaupt
# bemerken. Wer stattdessen die Bindungsprozedur direkt aufruft, umgeht
# den Fokus -- und misst wieder nur das Stueck statt der Bedienung.

package require tcltest 2.5
namespace import ::tcltest::*

package require Tk
package require pdfiumtcl

set here [file dirname [file normalize [info script]]]
set ::formular [file join $here fixtures form.pdf]
testConstraint haveFormPdf [file readable $::formular]

# viewer4.tcl haelt seinen Zustand global und baut in ".". Es einmal zu
# laden und dann zu bedienen ist naeher an der Wirklichkeit als ein
# Nachbau -- ein Nachbau haette den Fehler nicht gehabt.
if {[file readable [file join $here .. app viewer4.tcl]]} {
    set ::argv [list $::formular]
    set ::argc 1
    source [file join $here .. app viewer4.tcl]
    # WARTEN, bis das Dokument offen ist.
    #
    # viewer4 oeffnet verzoegert ("after idle"), damit das Fenster
    # zuerst steht. Ein Test, der sofort nachsieht, misst den Zustand
    # VOR dem Oeffnen -- und meldet einen Fehler, den es nicht gibt.
    # Genau so ist mir dieser Test beim ersten Lauf umgefallen.
    set ::wartete 0
    while {$::state(doc) eq "" && $::wartete < 50} {
        after 100 {set ::weiter 1}
        vwait ::weiter
        incr ::wartete
        update
    }
    testConstraint haveViewer [expr {$::state(doc) ne ""}]
} else {
    testConstraint haveViewer 0
}

# Die Mitte eines Feldes in Canvas-Pixel.
proc feldMitteCanvas {nr} {
    global state
    set e [lindex [pdfium::formfields $state(doc) $state(page)] $nr]
    lassign [lindex $e 4] l u r o
    lassign [pdfium::pagesize $state(doc) $state(page)] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width  pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    return [list [expr {int((($l + $r) / 2.0) * $sx)}] \
                 [expr {int(($hpt - ($u + $o) / 2.0) * $sy)}]]
}

proc feldWert {nr} {
    global state
    return [lindex [lindex [pdfium::formfields $state(doc) $state(page)] $nr] 2]
}

test viewer-forms-1.1 {die Sitzung laeuft ohne Zutun} \
        -constraints {haveFormPdf haveViewer} -body {
    # Kein Knopf, kein Modus: wer ein Formular oeffnet, soll schreiben
    # koennen. Ein Modus, den man erst findet, ist keiner.
    expr {$::state(edit) ne ""}
} -result 1

test viewer-forms-1.2 {erst in die Liste klicken, DANN auf die Seite} \
        -constraints {haveFormPdf haveViewer} -body {
    # DIE REIHENFOLGE, an der es gescheitert ist.
    #
    # Der Benutzer waehlt ein Feld in der Liste -- damit hat die Liste
    # den Tastaturfokus. Dann klickt er auf die Seite und tippt. Holt
    # der Klick den Fokus nicht zurueck, kommt keine Taste an, und die
    # Statuszeile sagt trotzdem "Schreibmarke gesetzt".
    #
    # "event generate" folgt dem Fokus -- also faellt genau das hier auf.
    set tv .pw.right.nb.form.tv
    focus -force $tv
    update

    lassign [feldMitteCanvas 0] cx cy
    tippenKlick $cx $cy
    update

    set vorher [feldWert 0]
    event generate . <Key-X> -keysym X
    update
    tippenAus
    update
    set nachher [feldWert 0]
    list [expr {[focus] eq ".pw.left.c"}] [expr {$nachher ne $vorher}]
} -result {1 1}

test viewer-forms-1.3 {ein Klick markiert das Feld sichtbar} \
        -constraints {haveFormPdf haveViewer} -body {
    # Auf dem Bildschirmfoto war nach dem Klick nichts zu sehen -- das
    # Feld sah aus wie vorher. Eine Rueckmeldung, die es nicht gibt,
    # laesst den Benutzer glauben, es sei nichts passiert.
    tippenAn 1
    update
    lassign [feldMitteCanvas 0] cx cy
    tippenKlick $cx $cy
    update
    set n [llength [.pw.left.c find withtag feldmark]]
    tippenAus 1
    expr {$n > 0}
} -result 1

test viewer-forms-1.4 {die Statuszeile ist breit genug fuer ihre Texte} \
        -constraints haveViewer -body {
    # "Schreibmarke gesetzt -- tippen" kam in der Werkzeugleiste als
    # "eibmarke gesetzt -- ti" an: ein Label mit -width 16 zwischen den
    # Knoepfen. Ich habe ein Dutzend Meldungen geschrieben und keine je
    # ganz gesehen.
    #
    # Geprueft wird die ANORDNUNG, nicht der Text: die Statuszeile muss
    # ein eigenes Fenster ueber die volle Breite sein und darf nicht in
    # der Werkzeugleiste haengen.
    list [winfo exists .status] \
         [expr {[winfo parent .status] eq "."}] \
         [lindex [pack info .status] [expr {[lsearch [pack info .status] -side] + 1}]]
} -result {1 1 bottom}

test viewer-forms-2.1 {tippen, speichern, wieder oeffnen} \
        -constraints {haveFormPdf haveViewer} -body {
    # DIE FOLGE, DIE NIE IN EINEM STUECK GEMESSEN WURDE.
    #
    # Die Teile einzeln waren geprueft: tippen wirkt, "Gefuellt
    # speichern" schreibt eine Datei, formfields liest. Ob sie in DIESER
    # Reihenfolge zusammengehen, stand nirgends -- und genau das ist die
    # Sorte Luecke, an der heute schon dreimal etwas haengengeblieben
    # ist.
    #
    # Heikel daran: PDFium schreibt den Feldinhalt erst beim
    # FOKUSVERLUST fest. Wer waehrend einer offenen Sitzung speichert,
    # koennte den zuletzt getippten Wert verlieren -- er steht dann in
    # der Sitzung und nicht im Dokument.
    set aus [file join [temporaryDirectory] vf-[pid].pdf]
    file delete $aus

    tippenAn 1
    update
    lassign [feldMitteCanvas 0] cx cy
    tippenKlick $cx $cy
    update
    focus -force .pw.left.c
    foreach z {V r e d e n} { event generate . <Key> -keysym $z }
    update

    # OHNE vorher zu beenden -- so wuerde ein Benutzer es tun: tippen,
    # dann auf den Knopf.
    proc tk_getSaveFile {args} [list return $aus]
    demo_formSave
    update
    catch {rename tk_getSaveFile {}}

    set gefunden ""
    if {[file exists $aus]} {
        set e [pdfium::open $aus]
        set gefunden [lindex [lindex [pdfium::formfields $e 0] 0] 2]
        pdfium::close $e
    }
    tippenAus 1
    file delete $aus
    list [file exists $aus] [string match "*Vreden*" $gefunden]
} -result {0 1}

test viewer-forms-2.2 {die Vorlage wird nicht ueberschrieben} \
        -constraints {haveFormPdf haveViewer} -body {
    # Derselbe Name wie die geoeffnete Datei muss abgelehnt werden --
    # sonst ist die leere Vorlage weg, und zwar unwiderruflich.
    set gemeldet 0
    proc tk_getSaveFile {args} [list return $::formular]
    proc tk_messageBox {args} {set ::gemeldet 1 ; return ok}
    set vorher [file size $::formular]
    demo_formSave
    catch {rename tk_getSaveFile {}}
    catch {rename tk_messageBox {}}
    list $::gemeldet [expr {[file size $::formular] == $vorher}]
} -result {1 1}


test viewer-forms-3.1 {der Doppelklick fuellt trotz laufender Sitzung} \
        -constraints {haveFormPdf haveViewer} -body {
    # DIE REIHENFOLGE, die seit der selbststartenden Sitzung kaputt war.
    #
    # PDFium vertraegt nur eine Formularumgebung je Dokument; solange
    # die Sitzung laeuft, findet formfill die Felder nicht. Die Sitzung
    # wird darum fuer die Dauer des Aufrufs ausgesetzt und danach
    # wieder aufgesetzt.
    #
    # Gemeldet 07.09.2026. Kein Test hatte das gefangen: basic.test
    # prueft formfill OHNE Sitzung, viewer-forms prueft das Tippen OHNE
    # formfill. Jedes Stueck fuer sich war gruen.
    set tv .pw.right.nb.form.tv
    proc ::demo_fragText {t v} { return "Spedition Muster" }
    tippenAn 1
    update
    $tv selection set [lindex [$tv children {}] 0]
    ::demo_formFill
    update
    set wert [$tv set [lindex [$tv children {}] 0] value]
    set nachher [expr {$::state(edit) ne ""}]
    tippenAus 1
    list $wert $nachher
} -result {{Spedition Muster} 1}

test viewer-forms-4.1 {jedes Feld der Seite bekommt einen Rahmen} \
        -constraints {haveFormPdf haveViewer} -body {
    # EIN LEERES WIDGET TRAEGT EINEN LEEREN ERSCHEINUNGSSTROM, und
    # PDFium zeichnet genau den -- also ist der Kasten nicht da. Auf dem
    # Bildschirm sah eine Vorlage wie ein leeres Blatt mit Beschriftung
    # aus, obwohl der Reiter "Formular" die Felder auflistete.
    #
    # Bis dahin umrandete der Viewer nur das AUSGEWAEHLTE Feld gruen.
    # Wer nicht in den Reiter klickte, sah keine Felder.
    #
    # Der Viewer malt die Rechtecke jetzt selbst, aus "formfields". An
    # den Dateien ist nichts geaendert -- die leeren Stroeme bleiben.
    #
    # Dass manche Dateien trotzdem richtig aussahen, ist ein Zufall: ein
    # Dokument mit Rechenfeld bekommt /NeedAppearances, und dann baut
    # der Betrachter die Erscheinungen selbst, Kreise und Kaesten
    # eingeschlossen. Gemessen an demo-forms.pdf: 6951 dunkle Punkte
    # ohne Formularschicht, 8858 mit -- bei den anderen Vorlagen
    # aenderte sie nichts.
    expr {[llength [.pw.left.c find withtag feldrahmen]] > 0}
} -result 1

test viewer-forms-4.2 {die Rahmen ueberleben Klick, Tippen und Fuellen} \
        -constraints {haveFormPdf haveViewer} -body {
    # show_page raeumt mit "delete all" auf, und tippenZeichnen ebenso.
    # Ohne Nachziehen waeren die Rahmen nach dem ersten Tastendruck weg
    # -- und das faellt erst auf, wenn man tippt.
    proc ::demo_fragText {t v} { return "Muster" }
    tippenAn 1
    update
    set nach1 [llength [.pw.left.c find withtag feldrahmen]]
    lassign [feldMitteCanvas 0] cx cy
    tippenKlick $cx $cy
    update
    set nach2 [llength [.pw.left.c find withtag feldrahmen]]
    tippenTaste M M
    update
    set nach3 [llength [.pw.left.c find withtag feldrahmen]]
    tippenAus 1
    update
    set nach4 [llength [.pw.left.c find withtag feldrahmen]]
    expr {$nach1 > 0 && $nach2 == $nach1 && $nach3 == $nach1
          && $nach4 == $nach1}
} -result 1

set ::gruppePdfV [file join [file dirname [file normalize [info script]]] \
        fixtures form-gruppe.pdf]
testConstraint haveGruppeV [file readable $::gruppePdfV]
set ::dreiPdfV [file join [file dirname [file normalize [info script]]] \
        fixtures form-drei.pdf]
testConstraint haveDreiV [file readable $::dreiPdfV]

test viewer-forms-5.1 {die ZWEITE Optionszeile waehlt Express} \
        -constraints {haveGruppeV haveViewer} -body {
    # DIE API KONNTE ES LAENGST -- basic.test 2.60 waehlt "express" ueber
    # den Exportwert. Die BEDIENUNG konnte es nicht: der Viewer schickte
    # einen Wahrheitswert an den GRUPPENNAMEN, und der trifft immer das
    # erste Widget. Express und Overnight waren nicht waehlbar, und nach
    # Normal hiess es "schon gewaehlt".
    #
    # Gruene API-Tests sagen nichts ueber die Bedienung. Das ist die
    # Luecke, die diese Datei schliessen soll -- und sie war bis
    # 08.09.2026 ungetestet.
    #
    # Die Feldliste fuehrt je Zeile ihr eigenes Rechteck; ein Klick
    # dorthin trifft genau dieses Widget.
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set n 0
    foreach id [$tv children {}] {
        if {[$tv set $id id] ne "prio"} continue
        incr n
        if {$n == 2} { $tv selection set $id ; break }
    }
    ::demo_formFill
    update
    set wert ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "prio"} { set wert [$tv set $id value] ; break }
    }
    set wert
} -result express

test viewer-forms-5.2 {eine Combobox wird GEWAEHLT, nicht getippt} \
        -constraints {haveGruppeV haveViewer} -body {
    # Ein Kombinationsfeld ohne Bearbeitungsflagge nimmt keinen Freitext
    # -- der Viewer fragte trotzdem danach. Die erlaubten Werte stehen
    # seit 0.6.3 in "formfields"; die Feldliste fuehrte sie nur nicht
    # mit.
    #
    # demo_fragText darf hier NICHT aufgehen: waere es ein Textdialog,
    # bekaeme der Benutzer eine Frage nach etwas, das das Feld nicht
    # annimmt.
    set ::textDialogKam 0
    rename ::demo_fragText ::demo_fragTextEcht
    proc ::demo_fragText {t v} { set ::textDialogKam 1 ; return "" }
    rename ::demo_fragWahl ::demo_fragWahlEcht
    proc ::demo_fragWahl {t werte jetzt} { return [lindex $werte 1] }

    set tv .pw.right.nb.form.tv
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { $tv selection set $id ; break }
    }
    ::demo_formFill
    update
    set wert ""
    set opts {}
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} {
            set wert [$tv set $id value]
            set opts [$tv set $id options]
            break
        }
    }
    rename ::demo_fragText {} ; rename ::demo_fragTextEcht ::demo_fragText
    rename ::demo_fragWahl {} ; rename ::demo_fragWahlEcht ::demo_fragWahl
    list $wert $::textDialogKam [llength $opts]
} -result {{Artikel B} 0 4}

test viewer-forms-5.3 {die Pfeiltasten waehlen in einer Combobox auf der Seite} \
        -constraints {haveGruppeV haveViewer} -body {
    # DIE TASTATURZUORDNUNG HINKTE DER API HINTERHER.
    #
    # "editkey" hat "up" und "down" bekommen, als formfill Auswahlfelder
    # lernte. "tippenTaste" kannte sie nie -- sie fielen in den
    # default-Zweig, wo ein leeres %A stillschweigend verworfen wird.
    #
    # Auf der API-Ebene ging es die ganze Zeit: editclick, dann "down",
    # ergibt "Artikel A". Im Viewer kam nichts an, und niemand sah
    # warum: kein Fehler, keine Meldung, nur nichts.
    #
    # Gemeldet 08.09.2026 als "combobox funktioniert noch nicht".
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set box {}
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set box [$tv set $id box] ; break }
    }
    if {[llength $box] != 4} { return "kein Rechteck" }
    lassign $box l u r o
    lassign [pdfium::pagesize $::state(doc) 0] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int((($l + $r) / 2) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    tippenTaste Down {}
    tippenAus 1
    update
    set wert ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set wert [$tv set $id value] }
    }
    set wert
} -result {Artikel A}

test viewer-forms-5.4 {nach der Wahl steht der Wert SOFORT in der Feldliste} \
        -constraints {haveGruppeV haveViewer} -body {
    # DER UNTERSCHIED ZWISCHEN "gespeichert" UND "sichtbar".
    #
    # Gemeldet 08.09.2026 mit drei Bildschirmfotos: Liste aufgeklappt,
    # "Sonderbestellung" gewaehlt und im Feld zu sehen, danach wieder
    # leer. In der gespeicherten Datei stand der Wert -- es war ein
    # ANZEIGEFEHLER, kein Speicherfehler.
    #
    # PDFium schreibt beim Fokusverlust fest. Nach einer Wahl aus der
    # Liste ist die Eingabe fertig, also gibt der Viewer den Fokus ab
    # und nimmt die Sitzung neu auf.
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set box {}
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set box [$tv set $id box] ; break }
    }
    if {[llength $box] != 4} { return "kein Rechteck" }
    lassign $box l u r o
    lassign [pdfium::pagesize $::state(doc) 0] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int(($r - 6) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    tippenKlick [expr {int(($l + 40) * $sx)}] \
                [expr {int(($hpt - ($u - 44)) * $sy)}]
    update
    set wert ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set wert [$tv set $id value] }
    }
    tippenAus 1
    expr {$wert ne ""}
} -result 1

test viewer-forms-6.1 {der Mitschnitt haelt Klick und Antwort fest} \
        -constraints {haveGruppeV haveViewer} -body {
    # WOZU.
    #
    # Am 08.09.2026 hat dieselbe Meldung -- "combobox funktioniert
    # nicht" -- dreimal etwas anderes bedeutet: die Feldliste, der Klick
    # auf der Seite, der Eintrag in der offenen Liste. Jedes Mal habe
    # ich das Gemessene repariert und das Gemeinte verfehlt.
    #
    # Ein Satz laesst drei Deutungen zu. Ein Mitschnitt laesst keine:
    # er nennt die Reihenfolge, die Koordinaten in BEIDEN Systemen und
    # die Antwort der Bindung.
    #
    #     Klick Fenster 416/445 -> Seite 199.1/628.9
    #     pdfium::editclick ... -> 2
    set datei [file join [temporaryDirectory] spur-[pid].txt]
    open_pdf $::gruppePdfV
    update
    spurAn $datei
    set tv .pw.right.nb.form.tv
    set box {}
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set box [$tv set $id box] ; break }
    }
    lassign $box l u r o
    lassign [pdfium::pagesize $::state(doc) 0] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int(($r - 6) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    tippenAus 1
    spurAus
    set ch [open $datei r]
    set inhalt [read $ch]
    close $ch
    file delete $datei
    list [string match "*Klick Fenster*Seite*" $inhalt] \
         [string match "*pdfium::editclick*" $inhalt]
} -result {1 1}

test viewer-forms-6.2 {das Seitenmass wird beim Dateiwechsel vergessen} \
        -constraints {haveGruppeV haveViewer haveDreiV} -body {
    # AUS EINEM MITSCHNITT, 08.09.2026: bei jedem Neuzeichnen stand
    # "pdfium::pagesize" sechzehnmal hintereinander -- einmal je Feld,
    # weil markiere_box es selbst holt und felderRahmen ueber alle
    # Felder laeuft. Insgesamt 101 Aufrufe in einer kurzen Sitzung,
    # jetzt 2.
    #
    # Aufgefallen war es niemandem: es war nicht falsch, nur
    # verschwendet. Im Betrieb sieht man das nicht, im Mitschnitt
    # sofort.
    #
    # Ein Zwischenspeicher ist nur so gut wie sein Vergessen: ein Mass,
    # das nach dem Dateiwechsel stehenbleibt, setzt jeden Rahmen an die
    # falsche Stelle.
    #
    # ACHTUNG BEIM LESEN DIESES TESTS: er war schon GRUEN, bevor das
    # Vergessen ueberhaupt eingebaut war -- der Schluessel enthaelt das
    # Dokument-Handle, und das war zufaellig verschieden. Darauf darf
    # man sich nicht verlassen: PDFium vergibt fuer ein neues Dokument
    # gern DIESELBE Adresse. Genau daran ist am selben Tag die
    # Formularumgebung haengengeblieben.
    #
    # Der Test prueft darum zusaetzlich, dass der Speicher nach dem
    # Wechsel WIRKLICH leer ist, und nicht bloss einen anderen
    # Schluessel hat.
    open_pdf $::gruppePdfV
    update
    set a [seitenmass]
    open_pdf $::dreiPdfV
    update
    set b [seitenmass]
    set echt [pdfium::pagesize $::state(doc) 0]
    # Nach dem Wechsel darf HOECHSTENS der Eintrag der neuen Datei da
    # sein -- der alte muss weg.
    set eintraege [llength [array names ::state mass,*]]
    list [expr {$a ne $b}] [expr {$b eq $echt}] $eintraege
} -result {1 1 1}

test viewer-forms-6.3 {beim Tippen steht der Text SOFORT in der Feldliste} \
        -constraints {haveGruppeV haveViewer} -body {
    # "per tastatur bleibt leer" -- gemeldet 08.09.2026 zusammen mit
    # einem Mitschnitt, der es genau zeigte: editchar -> 1, und danach
    # meldete formfields wieder "f_name {}".
    #
    # Die Bindung war in Ordnung. Was fehlte, war der Weg an den
    # laufenden Text: PDFium schreibt erst beim Fokusverlust fest, und
    # den Fokus abzugeben haette das Weitertippen verhindert.
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set ziel ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_name"} { set ziel $id ; break }
    }
    if {$ziel eq ""} { return "kein f_name" }
    $tv selection set $ziel
    lassign [$tv set $ziel box] l u r o
    lassign [seitenmass] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int((($l + $r) / 2) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    foreach z {f g} { tippenTaste $z $z ; update }
    set inListe [$tv set $ziel value]
    tippenAus 1
    set inListe
} -result fg

test viewer-forms-6.4 {ein Tab traegt nichts in fremde Zeilen ein} \
        -constraints {haveGruppeV haveViewer} -body {
    # "combobox benutzt, ploetzlich sind auch die anderen Felder mit
    # Daten" -- gemeldet 08.09.2026 mit einem Mitschnitt.
    #
    # Der Eintrag des laufenden Textes ging in die AUSGEWAEHLTE Zeile.
    # Nach einem Tab wandert der Fokus aber, und die Auswahl bleibt
    # stehen: der Inhalt von f_menge landete bei dem Feld, das der
    # Benutzer zuletzt angeklickt hatte.
    #
    # Zweitens teilt sich eine Optionsgruppe einen Namen -- drei Zeilen
    # heissen "prio". Der erste Treffer bekam den Eintrag, und ein
    # leerer Text loeschte das "Off": aus drei Zeilen wurden zwei.
    #
    # Geprueft wird darum die GANZE Liste, vorher und nachher.
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    proc _zeig {tv} {
        set aus {}
        foreach id [$tv children {}] {
            lappend aus "[$tv set $id id]=[$tv set $id value]"
        }
        return $aus
    }
    set ziel ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_firma"} { set ziel $id ; break }
    }
    $tv selection set $ziel
    lassign [$tv set $ziel box] l u r o
    lassign [seitenmass] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int((($l + $r) / 2) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    foreach z {g m b h} { tippenTaste $z $z ; update }
    set vorher [_zeig $tv]
    foreach n {1 2 3 4} { tippenTaste Tab "\t" ; update }
    set nachher [_zeig $tv]
    tippenAus 1
    rename _zeig {}
    # Der getippte Wert muss da sein, und sonst darf sich NICHTS
    # geaendert haben.
    list [expr {[lsearch -exact $vorher "f_firma=gmbh"] >= 0}] \
         [expr {$vorher eq $nachher}]
} -result {1 1}

test viewer-forms-6.5 {nach dem Festschreiben bleibt der Text auf der Seite} \
        -constraints {haveGruppeV haveViewer} -body {
    # DER STILLE C-FEHLER, den eine Durchsicht am 08.09.2026 benannt
    # hat: jeder Form-Befehl laedt sich eine EIGENE Seite -- ein zweites
    # Objekt derselben Seite -- trug sie in curPage ein und setzte
    # curPage danach auf NULL. Waehrend einer Sitzung gab FFI_GetPage
    # dann NULL zurueck.
    #
    # Sichtbar wird es NACH dem Festschreiben: waehrend des Tippens
    # zeichnet PDFium den Text aus dem Widget, nach dem Tab aus der
    # Seite -- und die fand es nicht mehr.
    #
    #     alt:  getippt 11567 -> nach Tab 11396   (Text weg)
    #     neu:  getippt 11567 -> nach Tab 11567   (Text bleibt)
    #
    # Gemeldet mit sieben Bildschirmfotos: die Feldliste zeigte "muster"
    # und "company", auf dem Blatt blieben Name und Firma leer -- bis
    # die Combobox benutzt wurde, denn die beendet die Sitzung und setzt
    # sie neu auf.
    #
    # DIESER TEST GEHOERT HIERHER, nicht in basic.test. Drei Anlaeufe
    # dort haben nichts gemessen: der Unterschied entsteht erst, wenn
    # der Viewer nach jedem Zeichen formfields ruft und die Seite neu
    # zeichnet. Ein Test auf der falschen Ebene ist gruen, egal was der
    # Code tut.
    proc _v65dunkel {} {
        set n 0
        for {set y 0} {$y < [image height pdfpage]} {incr y 3} {
            foreach z [pdfpage data -from 0 $y [image width pdfpage] \
                    [expr {$y + 1}]] {
                foreach px $z { if {$px ne "#ffffff"} { incr n } }
            }
        }
        return $n
    }
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set ziel ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_name"} { set ziel $id ; break }
    }
    $tv selection set $ziel
    lassign [$tv set $ziel box] l u r o
    lassign [seitenmass] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    tippenKlick [expr {int((($l + $r) / 2) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    foreach z {m u s t e r} { tippenTaste $z $z ; update }
    set getippt [_v65dunkel]
    tippenTaste Tab "\t"
    update
    set nachTab [_v65dunkel]
    tippenAus 1
    rename _v65dunkel {}
    # Die Schreibmarke faellt weg, ein paar Punkte weniger sind normal.
    # Ein ganzes Wort nicht -- gemessen 171.
    expr {$getippt - $nachTab < 60}
} -result 1

test viewer-forms-6.6 {die Feldliste zeigt die Laenge des Erscheinungsstroms} \
        -constraints {haveViewer} -body {
    # 0 heisst: die Datei sagt nicht, wie das Feld aussieht -- PDFium
    # zeichnet dann nichts, und man sucht den Fehler in der Bindung.
    # Genau das hat am 07./08.09.2026 einen halben Tag gekostet.
    #
    # Die Zahl gab es seit 0.6.4 in "formfields", nur sehen konnte man
    # sie nicht. Eine Diagnose, die man erst holen muss, holt niemand.
    set katB [file join [file dirname [file normalize [info script]]] \
            fixtures katalog fall-b-leer.pdf]
    if {![file readable $katB]} { return "keine Vorlage" }
    open_pdf $katB
    update
    set tv .pw.right.nb.form.tv
    set leer 0
    set voll 0
    foreach id [$tv children {}] {
        if {[$tv set $id ap] == 0} { incr leer } else { incr voll }
    }
    # In dieser Vorlage sind Text, Kaestchen und Optionsfelder leer,
    # Kombination und Liste nicht -- derselbe Erzeuger, dieselbe Datei.
    list [expr {"ap" in [$tv cget -displaycolumns]}] \
         [expr {$leer > 0}] [expr {$voll > 0}]
} -result {1 1 1}

test viewer-forms-6.7 {kein Feldrahmen ueber einer offenen Aufklappliste} \
        -constraints {haveGruppeV haveViewer} -body {
    # Gemeldet 08.09.2026 mit einem Bildschirmfoto: ein blauer Kasten
    # mitten in der offenen Liste.
    #
    # Es war der Rahmen von "f_menge" -- das Feld liegt bei y 631..647,
    # die Liste oeffnet sich von 673 bis 606 darueber. Der Rahmen war
    # RICHTIG, nur an einer Stelle sichtbar, an der er nichts zu suchen
    # hat: die Rahmen liegen auf dem Canvas ueber dem Bild, und die
    # Liste zeichnet PDFium ins Bild.
    #
    # PDFium nennt die Flaeche selbst -- FFI_Invalidate meldet nach dem
    # Klick {159 606 361 673}. Zum zweiten Mal zahlen sich die
    # Pflichtrueckrufe aus.
    #
    # Erkannt wird das Aufklappen an der HOEHE der gemeldeten Flaeche:
    # nach jedem Tastendruck meldet PDFium ebenfalls einen Bereich, und
    # der ist das Feld. "Irgendetwas hat sich geaendert" waere kein
    # Merkmal.
    open_pdf $::gruppePdfV
    update
    set tv .pw.right.nb.form.tv
    set ziel ""
    foreach id [$tv children {}] {
        if {[$tv set $id id] eq "f_artikel"} { set ziel $id ; break }
    }
    # OHNE AUSWAHL IN DER LISTE -- so, wie ein Klick auf die Seite es
    # hinterlaesst.
    #
    # Der erste Anlauf hier waehlte die Zeile vorher aus, und die
    # Erkennung las die Feldhoehe daraus. Beim Klick direkt auf die
    # Seite ist nichts ausgewaehlt, die Hoehe blieb 0, und die Rahmen
    # standen weiter ueber der Liste. Gemeldet 08.09.2026 mit einem
    # zweiten Bildschirmfoto -- der Test war gruen, der Fehler da.
    lassign [$tv set $ziel box] l u r o
    $tv selection remove [$tv children {}]
    lassign [seitenmass] wmm hmm
    set hpt [expr {$hmm * 72.0 / 25.4}]
    set sx [expr {[image width pdfpage] / ($wmm * 72.0 / 25.4)}]
    set sy [expr {[image height pdfpage] / $hpt}]
    tippenAn 1
    update
    set vorher [llength [.pw.left.c find withtag feldrahmen]]
    tippenKlick [expr {int(($r - 6) * $sx)}] \
                [expr {int(($hpt - ($u + $o) / 2) * $sy)}]
    update
    set nachher [llength [.pw.left.c find withtag feldrahmen]]
    set flaeche $::state(offeneliste)
    tippenAus 1
    # Die Flaeche muss erkannt sein, und es muessen WENIGER Rahmen sein.
    list [expr {[llength $flaeche] == 4}] [expr {$nachher < $vorher}]
} -result {1 1}

::tcltest::cleanupTests
